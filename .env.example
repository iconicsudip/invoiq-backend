# ============================================================
# Invoiq — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
API_PREFIX=api/v1

# Security
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this-immediately
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-min-64-chars
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Database
DATABASE_URL=postgresql://workspace_user:strong_password@localhost:5432/invoiq?schema=public&connection_limit=20&pool_timeout=10

# Redis (for rate limiting & queue)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# AWS S3 / Cloudflare R2
STORAGE_PROVIDER=r2
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_S3_BUCKET=invoiq
AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://files.yourdomain.com

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Invoiq
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# SMS (Twilio for OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Puppeteer (PDF generation)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/invoiq/app.log
